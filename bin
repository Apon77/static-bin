#!/bin/sh
D="$HOME/bin"; mkdir -p "$D"
U="https://github.com/Apon77/static-bin/releases/download/v1.0.0"
ACTION="${1:-}"
[ -z "$ACTION" ] && echo "Usage: bin [i|r|s] [package1] [package2] ..." && exit 1

shift

WGET_OPTS="--no-check-certificate -q"
if wget --help 2>&1 | grep -q "show-progress"; then WGET_OPTS="$WGET_OPTS --show-progress"; fi

for PKG in "$@"; do
    P="${PKG}.tar.gz"

    case "$ACTION" in
        i) echo "Downloading $PKG..."
           wget $WGET_OPTS -O "$D/$P" "$U/$P" && \
           tar xzf "$D/$P" -C "$D" && \
           rm -f "$D/$P" && \
           echo "Installed $PKG at $D" ;;
        r) rm -rf "$D/$PKG" && \
           echo "Removed $PKG from $D" ;;
        s)
    # Check if $2 exists; if shift was used earlier, look at $1 instead.
    if [ -n "$2" ]; then
        PKG="$2"
    else
        PKG="$1"
    fi
    
    # If both positions are empty, throw the error
    if [ -z "$PKG" ] || [ "$PKG" = "s" ]; then
        echo "❌ E: You must specify a package to search for."
        echo "Usage: ./bin s <package_name>"
        exit 1
    fi

    echo "Searching for $PKG..."
    echo
    
    RESULT=$(jq -r --arg query "$PKG" '
      [ .[] | select((.package | test($query; "i")) or (.summary | test($query; "i"))) | "\(.package)/\(.arch) \(.version)\n  \(.summary)" ] | join("\n\n")
    ' packages.json)

    if [ -n "$RESULT" ]; then
        echo -e "$RESULT"
        echo
        echo "✅ Match(es) found in local index."
    else
        echo "❌ E: Unable to locate package $PKG"
    fi
    ;;






        *) echo "Usage: bin [i|r|s] [package1] [package2] ..." && exit 1 ;;
    esac
done

