#!/bin/bash
D="$HOME/bin"; mkdir -p "$D"

P="$2.tar.gz"

case "$1" in
    i) [ -z "$2" ] && exit 1
       wget --no-check-certificate -q --show-progress -O "$D/$P" "https://github.com/Apon77/static-bin/releases/download/v1.0.0/$2.tar.gz"
       tar xzf "$D/$P" -C "$D" &
       TAR_PID=$!
       SPIN='-\|/'
       while kill -0 "$TAR_PID" 2>/dev/null; do
           printf "\b%s" "${SPIN:i++%4:1}"
           sleep 0.1
       done
       printf "\bInstalled $2\n"

       # 3. Clean up archive
       rm -f "$D/$P" ;;
    r) [ -z "$2" ] && exit 1
       rm -rf "$D/$2" && echo Removed $2;;
    *) echo "Usage: bin [i|r] [package]" && exit 1 ;;
esac

